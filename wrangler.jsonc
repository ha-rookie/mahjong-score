{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahjong-score",
  "compatibility_date": "2026-09-23",
  "main": "src/worker.ts",
  "preview_urls": true,
  "vars": {
    "LINE_CHANNEL_ID": "2011726648"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahjong-score-performance",
      "database_id": "37b05ca8-9f6e-46b4-92be-7e02513cf044",
      "preview_database_id": "2494979f-57d5-4ba5-bde7-bc5ec674b8eb"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "mahjong-score-preview",
        "database_id": "2494979f-57d5-4ba5-bde7-bc5ec674b8eb"
      }
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
