{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahjong-score-passkey-s2b-isolated",
  "compatibility_date": "2026-09-23",
  "main": "src/worker.ts",
  "preview_urls": true,
  "vars": {
    "PASSKEY_AUTH_ENVIRONMENT": "isolated-preview",
    "PASSKEY_PREVIEW_ORIGIN": "https://mahjong-score-passkey-s2b-isolated.ha-rookie.workers.dev",
    "PASSKEY_REGISTRATION_ENABLED": "false",
    "LINE_CHANNEL_ID": "REPLACE_WITH_SEPARATE_LINE_TEST_CHANNEL_ID"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahjong-score-passkey-s2b-isolated",
      "database_id": "REPLACE_WITH_NEW_ISOLATED_D1_UUID"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
